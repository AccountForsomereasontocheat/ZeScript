_addPhase("InteractTab functions", function()
    autoProxiEnabled = false; autoProxiInstant = Settings.autoProxiInstant
    autoProxiKey = Enum.KeyCode[Settings.autoProxiKey] or Enum.KeyCode.R
    isAutoProxiKeyHeld = false; autoProxiCooldowns = {}

    local PROXI_BLACKLIST = { "close", "leave", "hide" }; local INTERACTION_LIMIT = 5

    function shouldInteract(prompt)
        if not prompt or not prompt.Enabled then return false end
        local actionText = prompt.ActionText and prompt.ActionText:lower() or ""
        for _, word in ipairs(PROXI_BLACKLIST) do
            if actionText:find(word, 1, true) then return false end
        end
        if actionText:find("exit", 1, true) and not actionText:find("door", 1, true) then return false end
        if prompt.ObjectText == "Painting" then return false end
        local interactAttr = prompt:GetAttribute("Interactions" .. LocalPlayer.Name)
        if interactAttr and interactAttr > INTERACTION_LIMIT then return false end
        return true
    end

    function getPromptPosition(prompt)
        local obj = prompt.Parent; if not obj then return nil end
        if obj:IsA("BasePart") then return obj.Position end
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok and pivot then return pivot.Position end
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        return part and part.Position or nil
    end

    function firePrompt(prompt)
        if autoProxiInstant and prompt.HoldDuration > 0 then
            local orig = prompt.HoldDuration; prompt.HoldDuration = 0; fireproximityprompt(prompt)
            task.delay(0.1, function() if prompt and prompt.Parent then prompt.HoldDuration = orig end end)
        else
            fireproximityprompt(prompt)
        end
    end

    cachedPrompts = {}; promptCacheTime = 0

    function rebuildPromptCache()
        local newCache = {}
        local sources = {}
        local currentRooms = workspace:FindFirstChild("CurrentRooms")
        if currentRooms then table.insert(sources, currentRooms) end
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then table.insert(sources, playerGui) end
        for _, source in ipairs(sources) do
            for _, obj in ipairs(source:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then table.insert(newCache, obj) end
            end
        end
        cachedPrompts = newCache; promptCacheTime = tick()
    end

    function runAutoProxi()
        safeCall(function()
            local char = LocalPlayer.Character; if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            local playerPos = hrp.Position; local now = tick()
            if now - promptCacheTime >= PROMPT_CACHE_TTL then rebuildPromptCache() end
            local batch = {}
            for _, obj in ipairs(cachedPrompts) do
                if not obj or not obj.Parent then continue end
                if not shouldInteract(obj) then continue end
                local pos = getPromptPosition(obj); local maxDist = (obj.MaxActivationDistance or 10) + 4
                if pos and (playerPos - pos).Magnitude > maxDist then continue end
                local id = tostring(obj)
                if autoProxiCooldowns[id] and (now - autoProxiCooldowns[id]) < 0.1 then continue end
                autoProxiCooldowns[id] = now; table.insert(batch, obj)
            end
            local fired = 0
            for _, prompt in ipairs(batch) do
                if not prompt or not prompt.Parent then continue end
                firePrompt(prompt); fired = fired + 1
                if fired >= 5 then fired = 0; task.wait() end
            end
            for id, t in pairs(autoProxiCooldowns) do
                if now - t > 5 then autoProxiCooldowns[id] = nil end
            end
        end, "Run Auto Proxi")
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        safeCall(function()
            if input.KeyCode ~= autoProxiKey or gameProcessed then return end
            isAutoProxiKeyHeld = true
            if autoProxiEnabled then runAutoProxi() end
        end, "Input Began")
    end)
    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        safeCall(function()
            if input.KeyCode == autoProxiKey then isAutoProxiKeyHeld = false end
        end, "Input Ended")
    end)

    autoProxiToggle = InteractBox:AddToggle("AutoProxi", {
        Text = isMobile and "Loot Aura" or "Auto Proxi (Hold R)",
        Default = Settings.autoProxi, Tooltip = "Hold R to auto interact with nearby prompts",
        Callback = function(enabled)
            safeCall(function()
                autoProxiEnabled = enabled; Settings.autoProxi = enabled
                autoProxiCooldowns = {}; cachedPrompts = {}; promptCacheTime = 0
                if enabled then
                    autoProxiLoop = task.spawn(function()
                        while autoProxiEnabled do
                            task.wait(0.1)
                            if isMobile then
                                autoProxiCooldowns = {}; promptCacheTime = 0; runAutoProxi()
                            elseif isAutoProxiKeyHeld then
                                autoProxiCooldowns = {}; promptCacheTime = 0; runAutoProxi()
                            end
                        end
                    end)
                else
                    if autoProxiLoop then task.cancel(autoProxiLoop); autoProxiLoop = nil end
                end
            end, "Auto Proxi Toggle")
        end,
    })

    -- Keybind hangs off the toggle (PC only) — Obsidian pattern
    if not isMobile then
        autoProxiToggle:AddKeyPicker("AutoProxiKey", {
            Text = "Auto Proxi Key", Default = Settings.autoProxiKey, Mode = "Hold",
        })
        Library.Options.AutoProxiKey:OnChanged(function()
            safeCall(function()
                local keyName = Library.Options.AutoProxiKey.Value
                autoProxiKey = Enum.KeyCode[keyName] or Enum.KeyCode.R
                Settings.autoProxiKey = keyName
            end, "Auto Proxi Keybind Changed")
        end)
    end

    InteractBox:AddToggle("InstantInteract", {
        Text = "Instant Interact", Default = Settings.autoProxiInstant,
        Tooltip = "Bypass hold duration on prompts",
        Callback = function(enabled)
            safeCall(function()
                autoProxiInstant = enabled; Settings.autoProxiInstant = enabled
            end, "Instant Interact Toggle")
        end,
    })
end)

