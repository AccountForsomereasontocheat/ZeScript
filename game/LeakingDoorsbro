_addPhase("Hook init & hook toggles", function()
    antiHeartbeatEnabled = false; antiA90Enabled = false; hooksInitialized = false

    function initHooks()
        if hooksInitialized then return end
        if not hookSupported then warn("[ZeScript] initHooks: hook support unavailable"); return end
        local ok, err = pcall(function()
            local HideMonster = ReplicatedStorage:WaitForChild("RemotesFolder"):WaitForChild("HideMonster")
            local A90Remote   = ReplicatedStorage:WaitForChild("RemotesFolder"):WaitForChild("A90")
            local hookfunc = hookfunction or replaceclosure or hookmetamethod
            if not hookfunc then warn("[ZeScript] No hook function found!"); return end
            local oldNamecall
            oldNamecall = hookfunc(
                getrawmetatable(game).__namecall,
                function(self, ...)
                    local method = getnamecallmethod()
                    if method == "FireServer" then
                        if antiHeartbeatEnabled and self == HideMonster then return end
                        if antiA90Enabled and self == A90Remote then
                            local args = {...}
                            if args[1] == "moved" then return oldNamecall(self, "didnt") end
                        end
                    end
                    return oldNamecall(self, ...)
                end
            )
            hooksInitialized = true
        end)
        if not ok then warn("[ZeScript] initHooks FAILED: " .. tostring(err)) end
    end

    if hookSupported then
        ProtectionBox:AddToggle("AntiHeartbeat", {
            Text = "Anti Heartbeat Kick", Default = false,
            Tooltip = "Blocks Figure's heartbeat minigame from killing you",
            Callback = function(enabled)
                safeCall(function()
                    antiHeartbeatEnabled = enabled
                    if enabled then initHooks() end
                    notify(enabled and "Anti Heartbeat enabled!" or "Anti Heartbeat disabled.", 3, enabled and "Success" or "Warning")
                end, "Anti Heartbeat Toggle")
            end,
        })

        ProtectionBox:AddToggle("NoCameraShake", {
            Text = "No Camera Shake", Default = false,
            Tooltip = "Disables all camera shake effects",
            Callback = function(enabled)
                safeCall(function()
                    local RS = game:GetService("ReplicatedStorage")
                    local shakerModule = RS:FindFirstChild("CameraShaker")
                    if not shakerModule then notify("CameraShaker not found", 3, "Error"); return end
                    local ok, shaker = pcall(require, shakerModule)
                    if not ok or not shaker then notify("Failed to require CameraShaker", 3, "Error"); return end
                    if enabled then
                        local hookfunc = hookfunction or replaceclosure
                        if hookfunc and shaker.Update then
                            getgenv()._origCamShakeUpdate = hookfunc(shaker.Update, function(self, dt) return CFrame.new() end)
                        end
                        notify("No Camera Shake enabled!", 3, "Success")
                    else
                        if getgenv()._origCamShakeUpdate then
                            local hookfunc = hookfunction or replaceclosure
                            if hookfunc and shaker.Update then hookfunc(shaker.Update, getgenv()._origCamShakeUpdate) end
                            getgenv()._origCamShakeUpdate = nil
                        end
                        notify("Camera Shake restored.", 3, "Warning")
                    end
                end, "No Camera Shake Toggle")
            end,
        })

        ProtectionBox:AddToggle("AntiA90", {
            Text = "Anti A-90", Default = false,
            Tooltip = "Replaces A-90 death signal with survival signal",
            Callback = function(enabled)
                safeCall(function()
                    antiA90Enabled = enabled
                    if enabled then initHooks() end
                    notify(enabled and "Anti A-90 enabled!" or "Anti A-90 disabled.", 3, enabled and "Success" or "Warning")
                end, "Anti A90 Toggle")
            end,
        })
    else
        ProtectionBox:AddLabel("❌ Anti Heartbeat — requires hook support (unsupported executor)")
        ProtectionBox:AddLabel("❌ Anti A-90 — requires hook support (unsupported executor)")
    end
end)

