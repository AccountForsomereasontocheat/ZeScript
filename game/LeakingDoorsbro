local _logFile = "ZeScript_LoadLog.txt"
local function _log(msg)
    pcall(function()
        local existing = ""
        if isfile and isfile(_logFile) then existing = readfile(_logFile) end
        if writefile then writefile(_logFile, existing .. msg .. "\n") end
    end)
    warn(msg)
end

-- Unified notify helper — maps old Type field to Obsidian icons
local function notify(text, duration, notifType)
    local icon = nil
    if notifType == "Success" then icon = "check"
    elseif notifType == "Error"   then icon = "x"
    elseif notifType == "Warning" then icon = "triangle-alert"
    end
    if Library then
        pcall(function()
            Library:Notify({
                Title       = "ZeScript",
                Description = text,
                Time        = duration or 4,
                Icon        = icon,
            })
        end)
    else
        warn("[ZeScript Notify]: " .. text)
    end
end

local function safeCall(func, errorContext)
    local success, err = pcall(func)
    if not success then
        local errorMsg = "[ZeScript Error - " .. (errorContext or "Unknown") .. "]: " .. tostring(err)
        _log("[" .. os.date("%H:%M:%S") .. "] " .. errorMsg)
        notify(errorMsg, 5, "Error")
    end
    return success
end

