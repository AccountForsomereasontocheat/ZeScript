local _phases = {}
local _phaseNames = {}
local function _addPhase(name, fn)
    table.insert(_phases, fn)
    table.insert(_phaseNames, name)
end

local function _runPhases()
    pcall(function() if writefile then writefile(_logFile, "=== ZeScript Load Log ===\n") end end)
    for i, fn in ipairs(_phases) do
        local name = _phaseNames[i] or ("Phase " .. i)
        _log("[Phase " .. i .. "/" .. #_phases .. "] Starting: " .. name)
        local ok, err = pcall(fn)
        if not ok then
            local msg = "[Phase " .. i .. " FAILED] " .. name .. ": " .. tostring(err)
            _log(msg)
            pcall(function()
                Library:Notify({ Title = "Phase Error", Description = msg, Time = 10, Icon = "x" })
            end)
        else
            _log("[Phase " .. i .. "] OK: " .. name)
        end
        task.wait()
    end
    _log("[ZeScript] All phases complete. Showing window.")
    wait(0.2)
    Window:Toggle(true)
end

