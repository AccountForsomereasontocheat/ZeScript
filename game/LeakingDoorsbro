_addPhase("AntiSpeed & Speed", function()
    maxSpeedValue = currentFloor == "Mines" and 75 or 250
    antiSpeedEnabled = true

    function startAntiSpeedBypass()
        safeCall(function()
            local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local CollisionPart = Character:WaitForChild("CollisionPart")
            if clonedCollision then clonedCollision:Destroy(); clonedCollision = nil end
            clonedCollision = CollisionPart:Clone()
            clonedCollision.Name = "_CollisionClone"; clonedCollision.Massless = true
            clonedCollision.Parent = Character; clonedCollision.CanCollide = false
            clonedCollision.CanQuery = false
            clonedCollision.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.7, 0, 1, 1)
            if antiSpeedLoop then task.cancel(antiSpeedLoop); antiSpeedLoop = nil end
            antiSpeedLoop = task.spawn(function()
                while antiSpeedEnabled do
                    task.wait(0.23)
                    safeCall(function()
                        if clonedCollision then
                            clonedCollision.Massless = false
                            task.wait(0.23)
                            local root = Character:FindFirstChild("HumanoidRootPart")
                            if root and root.Anchored then clonedCollision.Massless = true; task.wait(1) end
                            clonedCollision.Massless = true
                        end
                    end, "Anti Speed Loop")
                end
            end)
        end, "AntiSpeed Bypass Auto-Start")
    end

    task.defer(startAntiSpeedBypass)
    LocalPlayer.CharacterAdded:Connect(function() task.wait(0.5); startAntiSpeedBypass() end)

    speedEnabled = false; originalWalkSpeed = 16; speedValue = Settings.speedValue

    EssentialsBox:AddToggle("EnableSpeed", {
        Text = "Enable Speed", Default = Settings.speed,
        Tooltip = "Increase walk speed - requires AntiSpeed Bypass",
        Callback = function(enabled)
            safeCall(function()
                speedEnabled = enabled; Settings.speed = enabled
                if enabled then
