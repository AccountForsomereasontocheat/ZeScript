    -- Auto Forgetmenots --
    local TARGET_ANIM_ID = "126064614098558"
    local function getHighestRoom()
        local currentRooms = workspace:FindFirstChild("CurrentRooms"); if not currentRooms then return nil end
        local highestNum = -1; local highestRoom = nil
        for _, child in currentRooms:GetChildren() do
            local num = tonumber(child.Name)
            if num and num > highestNum then highestNum = num; highestRoom = child end
        end
