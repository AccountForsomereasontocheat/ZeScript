    end
    local function isTargetAnimationPlaying()
        local character = LocalPlayer.Character; if not character then return false end
        local humanoid = character:FindFirstChildOfClass("Humanoid"); if not humanoid then return false end
        local animator = humanoid:FindFirstChildOfClass("Animator"); if not animator then return false end
        for _, track in animator:GetPlayingAnimationTracks() do
            if track.Animation and string.find(track.Animation.AnimationId, TARGET_ANIM_ID) then return true end
        end
