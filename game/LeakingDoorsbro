_addPhase("Hook check", function()
    hookSupported = false
    local hookfunc = hookfunction or replaceclosure or hookmetamethod
    if hookfunc then
        local testPassed = false
        local ok, err = pcall(function()
            local dummy = function() return 1 end
            local old
            old = hookfunc(dummy, function(...) return old(...) end)
            testPassed = true
            pcall(function() hookfunc(dummy, old) end)
        end)
        if ok and testPassed then
            hookSupported = true
        else
            warn("[ZeScript UNC] Hook test FAILED: " .. tostring(err))
        end
    else
        warn("[ZeScript UNC] No hook function available")
    end
    task.delay(1, function()
        if hookSupported then
            notify("✅ Hook support detected — all features available", 4, "Success")
        else
            notify("⚠️ No hook support — Anti Heartbeat & Anti A-90 unavailable", 7, "Warning")
        end
    end)
end)

