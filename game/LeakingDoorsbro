_addPhase("Discord register call", function()
    function registerWithDiscord()
        safeCall(function()
            local success1, response1 = pcall(function()
                return httpRequest({ Url = DISCORD_API_URL, Method = "GET" })
            end)
            if not success1 then
                notify("Can't reach server: " .. tostring(response1), 5, "Error"); return
            end
            local players = getAllPlayers()
            local success2, response2 = pcall(function()
                return httpRequest({
                    Url = DISCORD_API_URL .. "/api/register",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({ gameId = GAME_ID, players = players })
                })
            end)
            if success2 and response2.StatusCode == 200 then
                discordConnected = true
                notify("Log in successful", 3, "Success")
                task.spawn(function()
                    while discordConnected do task.wait(10); checkDiscordCommands() end
                end)
                task.spawn(function()
                    while discordConnected do
                        task.wait(10)
                        sendToDiscord("/api/players", { gameId = GAME_ID, players = getAllPlayers() })
                    end
                end)
            else
                notify("Registration failed: " .. (success2 and tostring(response2.StatusCode) or tostring(response2)), 5, "Error")
            end
        end, "Register With Discord")
    end
    registerWithDiscord()
end)

