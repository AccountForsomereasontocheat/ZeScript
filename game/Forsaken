local glitching            = false
local function initGodmodeHook()
    if hooksInitialized or not hookSupported then return end
    safeCall(function()
        local unreliableRemote = ReplicatedStorage
            :WaitForChild("Modules", 10)
            :WaitForChild("Network", 10)
            :WaitForChild("Network", 10)
            :WaitForChild("UnreliableRemoteEvent", 10)
        if not unreliableRemote then error("UnreliableRemoteEvent not found") end
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self == unreliableRemote then
                local args = table.pack(...)
                if (args[1] == 1 or args[1] == 2) and blocking then return end
            end
            return oldNamecall(self, ...)
        end)
        hooksInitialized = true
    end, "Init Godmode Hook")
end
local function doGlitch()
    if glitching then return end
    glitching = true
    local char = LocalPlayer.Character
    if char and char.PrimaryPart then
        local realCF = char.PrimaryPart.CFrame
        char.PrimaryPart.CFrame = realCF * CFrame.new(0, 500, 0)
        task.wait(0.06)
        char.PrimaryPart.CFrame = realCF * CFrame.new(0, 500, 0)
        blocking = true
        char.PrimaryPart.CFrame = realCF
        Window:Notify({ Text = "Godmode Activated", Duration = 2, Type = "Success" })
    end
    glitching = false
end
local function disableGlitch()
    blocking = false
    Window:Notify({ Text = "Godmode Deactivated", Duration = 2, Type = "Warning" })
end
local function stopAutoLoop()
    if godmodeAutoLoop then
        task.cancel(godmodeAutoLoop)
        godmodeAutoLoop = nil
    end
end
local function startAutoLoop()
    stopAutoLoop()
    godmodeAutoLoop = task.spawn(function()
        while Window.Flags["Godmode"] do
            task.wait(0.05)
            if godmodeMode ~= "Automatic" then continue end
            safeCall(function()
                local char = LocalPlayer.Character
                if not char or not char.PrimaryPart then return end
                local queryHitbox = char:FindFirstChild("QueryHitbox")
                if not queryHitbox then return end
                local dist = (queryHitbox.Position - char.PrimaryPart.Position).Magnitude
                if dist <= 50 and not glitching and not char.PrimaryPart.Anchored then
                    blocking = false
                    task.wait(0.2)
                    if Window.Flags["Godmode"] and godmodeMode == "Automatic" then
                        task.spawn(doGlitch)
                    end
                end
            end, "AutoLoop Tick")
        end
    end)
end
local godmodeApi
if hookSupported then
    ExploitsTab:Dropdown(
        "Godmode Mode",
        { "Manual (X)", "Automatic" },
        function(selected)
            if selected["Automatic"] then
                godmodeMode = "Automatic"
            else
                godmodeMode = "Manual (X)"
            end
            if not Window.Flags["Godmode"] then return end
            if godmodeMode == "Automatic" then
                if godmodeKeyConnection then
                    godmodeKeyConnection:Disconnect()
                    godmodeKeyConnection = nil
                end
                blocking = false
                task.spawn(doGlitch)
                startAutoLoop()
                Window:Notify({ Text = "Switched to Automatic — QueryHitbox drift monitor active", Duration = 3, Type = "Success" })
            else
                stopAutoLoop()
                if blocking then disableGlitch() end
                if godmodeKeyConnection then godmodeKeyConnection:Disconnect() end
                godmodeKeyConnection = UserInputService.InputBegan:Connect(function(input, gp)
                    if gp then return end
                    if input.KeyCode == Enum.KeyCode.X and Window.Flags["Godmode"] then
                        if blocking then disableGlitch() else task.spawn(doGlitch) end
                    end
                end)
                Window:Notify({ Text = "Switched to Manual — Press X to toggle", Duration = 3, Type = "Success" })
            end
        end,
        "Manual = press X to arm/disarm | Automatic = re-arms when QueryHitbox drifts >10 studs"
    )
    godmodeApi = ExploitsTab:Toggle(
        "Godmode",
        false,
        function(enabled)
            safeCall(function()
                if enabled then
                    initGodmodeHook()
                    if godmodeMode == "Automatic" then
                        if godmodeKeyConnection then
                            godmodeKeyConnection:Disconnect()
                            godmodeKeyConnection = nil
                        end
                        task.spawn(doGlitch)
                        startAutoLoop()
                        Window:Notify({ Text = "Godmode ON — Automatic mode active", Duration = 3, Type = "Success" })
                    else
                        if godmodeKeyConnection then godmodeKeyConnection:Disconnect() end
                        godmodeKeyConnection = UserInputService.InputBegan:Connect(function(input, gp)
                            if gp then return end
                            if input.KeyCode == Enum.KeyCode.X and Window.Flags["Godmode"] then
                                if blocking then disableGlitch() else task.spawn(doGlitch) end
                            end
                        end)
                        Window:Notify({ Text = "Godmode ON — Press X to activate", Duration = 3, Type = "Success" })
                    end
                else
                    stopAutoLoop()
                    if godmodeKeyConnection then
                        godmodeKeyConnection:Disconnect()
                        godmodeKeyConnection = nil
                    end
                    if blocking then disableGlitch() end
                    Window:Notify({ Text = "Godmode Disabled", Duration = 2, Type = "Warning" })
                end
            end, "Godmode Toggle")
        end,
        "Toggle godmode — mode controlled by the dropdown above"
    )
else
    ExploitsTab:Label("Godmode requires hook support (unsupported executor)")
end
