local speedBoostLoop   = nil
local speedBoostAmount = 1
local speedBoostApi    = ExploitsTab:Toggle(
    "Speed Boost",
    false,
    function(enabled)
        safeCall(function()
            if enabled then
                speedBoostLoop = task.spawn(function()
                    local RunService = game:GetService("RunService")
                    while Window.Flags["Speed Boost"] do
                        local dt = RunService.RenderStepped:Wait()
                        safeCall(function()
                            local char = LocalPlayer.Character
                            if not char or not char.PrimaryPart then return end
                            local humanoid = char:FindFirstChildOfClass("Humanoid")
                            if not humanoid or humanoid.MoveDirection.Magnitude == 0 then return end
                            if char.PrimaryPart.Anchored then return end
                            local cam = workspace.CurrentCamera
                            local camCF = CFrame.new(Vector3.zero, Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z))
                            local inputDir = humanoid.MoveDirection
                            local localDir = camCF:VectorToObjectSpace(inputDir)
                            local offset = camCF:VectorToWorldSpace(localDir) * speedBoostAmount * dt * 60
                            char.PrimaryPart.CFrame = char.PrimaryPart.CFrame + offset
                        end, "Speed Boost Tick")
                    end
                end)
                Window:Notify({ Text = "Speed Boost Enabled", Duration = 2, Type = "Success" })
            else
                if speedBoostLoop then task.cancel(speedBoostLoop); speedBoostLoop = nil end
                Window:Notify({ Text = "Speed Boost Disabled", Duration = 2, Type = "Warning" })
            end
        end, "Speed Boost Toggle")
    end,
    "Adds extra CFrame movement in the direction you're looking"
)
