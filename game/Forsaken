local hookSupported = false
do
    local ok, err = pcall(function()
        local mt = getrawmetatable(game)
        if not mt or not mt.__namecall then error("no __namecall") end
        if not hookmetamethod then error("no hookmetamethod") end
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...) return old(self, ...) end)
        hookSupported = true
        pcall(function() hookmetamethod(game, "__namecall", old) end)
    end)
    if not ok then warn("[ZeScript Forsaken] Hook test FAILED: " .. tostring(err)) end
    task.delay(1, function()
        if hookSupported then
            Window:Notify({ Text = "Hook support detected — Godmode available", Duration = 4, Type = "Success" })
        else
            Window:Notify({ Text = "No hook support — Godmode unavailable on this executor", Duration = 7, Type = "Warning" })
        end
    end)
end
