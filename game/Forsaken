local function safeCall(func, errorContext)
    local success, err = pcall(func)
    if not success then
        local msg = "[ZeScript Forsaken - " .. (errorContext or "Unknown") .. "]: " .. tostring(err)
        if Window and Window.Notify then
            Window:Notify({ Text = msg, Duration = 5, Type = "Error" })
        else
            warn(msg)
        end
    end
    return success
end
local function isGeneratorComplete(model)
    local progress = model:FindFirstChild("Progress")
    return progress and progress:IsA("NumberValue") and progress.Value >= 100
end
