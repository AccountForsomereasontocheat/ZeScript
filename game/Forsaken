local autoGenApi = ExploitsTab:Toggle(
    "Auto Generator",
    false,
    function(enabled)
        safeCall(function()
            if enabled then
                autoGenLoop = task.spawn(function()
                    while Window.Flags["Auto Generator"] do
                        safeCall(function()
                            local char = LocalPlayer.Character
                            if not char or not char.PrimaryPart then return end
                            local playerPos  = char.PrimaryPart.Position
                            local mapFolder  = workspace.Map.Ingame.Map
                            local closestGen, closestDist = nil, math.huge
                            for _, model in pairs(mapFolder:GetChildren()) do
                                if model.Name == "Generator" and not isGeneratorComplete(model) then
                                    local pp = model.PrimaryPart or model:FindFirstChildOfClass("BasePart")
                                    if pp then
                                        local dist = (pp.Position - playerPos).Magnitude
                                        if dist < closestDist then
                                            closestDist = dist
                                            closestGen  = model
                                        end
                                    end
                                end
                            end
                            if closestGen then
                                local re = closestGen:FindFirstChild("Remotes")
                                    and closestGen.Remotes:FindFirstChild("RE")
                                if re then
                                    re:FireServer()
                                    print("[AutoGen] Fired RE on:", closestGen.Name, "| Dist:", math.round(closestDist))
                                end
                            end
                        end, "AutoGen Tick")
                        task.wait(2.1)
                    end
                end)
                Window:Notify({ Text = "Auto Generator Enabled", Duration = 2, Type = "Success" })
            else
                if autoGenLoop then task.cancel(autoGenLoop); autoGenLoop = nil end
                Window:Notify({ Text = "Auto Generator Disabled", Duration = 2, Type = "Warning" })
            end
        end, "Auto Generator Toggle")
    end,
    "Automatically fires the closest generator remote every 2 seconds"
)
